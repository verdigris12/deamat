diff --git a/external/ImFileDialog/bindings/pybind_im_file_dialog.cpp b/external/ImFileDialog/bindings/pybind_im_file_dialog.cpp
index 29b1979..e850a98 100644
--- a/external/ImFileDialog/bindings/pybind_im_file_dialog.cpp
+++ b/external/ImFileDialog/bindings/pybind_im_file_dialog.cpp
@@ -91,6 +91,34 @@ void py_init_module_im_file_dialog(nb::module_& m)
             &ifd::FileDialog::GetResults)
         .def("close",
             &ifd::FileDialog::Close)
+        .def("set_texture_callbacks",
+            [](ifd::FileDialog& self, nb::callable create, nb::callable destroy) {
+                self.CreateTexture = [create](uint8_t* pixels, int width, int height, char format) -> ImTextureID {
+                    nb::gil_scoped_acquire gil;
+                    auto size = static_cast<Py_ssize_t>(width) * height * 4;
+                    nb::object view = nb::steal<nb::object>(PyMemoryView_FromMemory(
+                        reinterpret_cast<char*>(pixels), size, PyBUF_READ));
+                    if (!view.is_valid())
+                        throw nb::python_error();
+                    try {
+                        auto id = nb::cast<ImTextureID>(create(view, width, height, static_cast<int>(format)));
+                        view.attr("release")();
+                        return id;
+                    } catch (...) {
+                        view.attr("release")();
+                        throw;
+                    }
+                };
+                self.DeleteTexture = [destroy](ImTextureID id) {
+                    nb::gil_scoped_acquire gil;
+                    destroy(id);
+                };
+            }, nb::arg("create"), nb::arg("delete"))
+        .def("clear_texture_callbacks",
+            [](ifd::FileDialog& self) {
+                self.CreateTexture = {};
+                self.DeleteTexture = {};
+            })
         .def("remove_favorite",
             &ifd::FileDialog::RemoveFavorite, nb::arg("path"))
         .def("add_favorite",
